# 玩家存檔 (每台機器各自的資料,含密碼雜湊,不要上傳)
data/

# AI 產生的原始圖檔 (很大;整理好的成品在 public/assets/ 才進版控)
art-src/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 暫存與紀錄
*.tmp
*.bak
*.log

# Claude Code 的本機設定 (測試伺服器路徑等,每台電腦不同)
.claude/

# 編輯器
.vscode/
.idea/

# 作業系統 / OneDrive 產生的檔案
Thumbs.db
desktop.ini
.DS_Store
